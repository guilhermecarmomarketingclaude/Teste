 "vo": [
  {
   "id": "L01",
   "file": "longstay/narration2/L01.wav",
   "start": 3.95,
   "dur": 2.188,
   "text": "Uma semana no Algarve passa a voar."
  },
  {
   "id": "L02",
   "file": "longstay/narration2/L02.wav",
   "start": 7.02,
   "dur": 2.938,
   "text": "E se ficasse um mês… e pagasse menos por noite?"
  },
  {
   "id": "L03",
   "file": "longstay/narration2/L03.wav",
   "start": 11.56,
   "dur": 2.263,
   "text": "Para quem quer fugir ao frio do inverno."
  },
  {
   "id": "L04",
   "file": "longstay/narration2/L04.wav",
   "start": 13.96,
   "dur": 1.956,
   "text": "Para quem joga golfe o ano inteiro."
  },
  {
   "id": "L05",
   "file": "longstay/narration2/L05.wav",
   "start": 16.36,
   "dur": 1.722,
   "text": "Para quem trabalha de qualquer lado."
  },
  {
   "id": "L06",
   "file": "longstay/narration2/L06.wav",
   "start": 18.28,
   "dur": 1.653,
   "text": "Para quem está entre casas."
  },
  {
   "id": "L07",
   "file": "longstay/narration2/L07.wav",
   "start": 20.2,
   "dur": 1.084,
   "text": "Para quem vem estudar."
  },
  {
   "id": "L08",
   "file": "longstay/narration2/L08.wav",
   "start": 21.64,
   "dur": 2.679,
   "text": "Ou para quem, simplesmente, quer ficar mais tempo."
  },
  {
   "id": "E01",
   "file": "longstay/narration2/E01.wav",
   "start": 25.06,
   "dur": 2.566,
   "text": "O Algarve sabe melhor… sem pressa."
  },
  {
   "id": "L09",
   "file": "longstay/narration2/L09.wav",
   "start": 29.22,
   "dur": 4.43,
   "text": "Na HD Properties, temos casas prontas a viver, de Vilamoura a Olhão."
  },
  {
   "id": "L10",
   "file": "longstay/narration2/L10.wav",
   "start": 34.62,
   "dur": 3.312,
   "text": "Totalmente equipadas, com apoio local 24 horas por dia."
  },
  {
   "id": "L11",
   "file": "longstay/narration2/L11.wav",
   "start": 39.4,
   "dur": 2.134,
   "text": "E quanto mais tempo fica, menos paga:"
  },
  {
   "id": "L12",
   "file": "longstay/narration2/L12.wav",
   "start": 41.984,
   "dur": 3.599,
   "text": "em estadias com mais de 28 dias, tem 30% de desconto."
  },
  {
   "id": "L13",
   "file": "longstay/narration2/L13.wav",
   "start": 46.22,
   "dur": 1.506,
   "text": "Reserve já a sua estadia."
  },
  {
   "id": "L14",
   "file": "longstay/narration2/L14.wav",
   "start": 48.22,
   "dur": 2.24,
   "text": "HD Properties. Fale connosco."
  }
 ],
