 "vo": [
  {
   "id": "L01",
   "file": "longstay/narration/L01.wav",
   "start": 0.12,
   "dur": 2.35,
   "text": "Uma semana no Algarve passa a voar."
  },
  {
   "id": "L02",
   "file": "longstay/narration/L02.wav",
   "start": 3.3,
   "dur": 3.16,
   "text": "E se ficasse um mês… e pagasse menos por noite?"
  },
  {
   "id": "L03",
   "file": "longstay/narration/L03.wav",
   "start": 7.72,
   "dur": 2.0,
   "text": "Para quem foge ao frio do inverno."
  },
  {
   "id": "L04",
   "file": "longstay/narration/L04.wav",
   "start": 9.86,
   "dur": 2.1,
   "text": "Para quem joga golfe o ano inteiro."
  },
  {
   "id": "L05",
   "file": "longstay/narration/L05.wav",
   "start": 12.1,
   "dur": 1.85,
   "text": "Para quem trabalha de qualquer lado."
  },
  {
   "id": "L06",
   "file": "longstay/narration/L06.wav",
   "start": 14.08,
   "dur": 1.77,
   "text": "Para quem está entre casas."
  },
  {
   "id": "L07",
   "file": "longstay/narration/L07.wav",
   "start": 15.98,
   "dur": 1.16,
   "text": "Para quem vem estudar."
  },
  {
   "id": "L08",
   "file": "longstay/narration/L08.wav",
   "start": 17.4,
   "dur": 2.89,
   "text": "Ou para quem, simplesmente, quer ficar mais tempo."
  },
  {
   "id": "E01",
   "file": "longstay/narration/E01.wav",
   "start": 21.3,
   "dur": 2.76,
   "text": "O Algarve sabe melhor… sem pressa."
  },
  {
   "id": "L09",
   "file": "longstay/narration/L09.wav",
   "start": 25.25,
   "dur": 4.43,
   "text": "Na HD Properties, temos casas prontas a viver, de Vilamoura a Olhão."
  },
  {
   "id": "L10",
   "file": "longstay/narration/L10.wav",
   "start": 29.9,
   "dur": 3.57,
   "text": "Totalmente equipadas, com apoio local 24 horas por dia."
  },
  {
   "id": "L11",
   "file": "longstay/narration/L11.wav",
   "start": 33.75,
   "dur": 2.29,
   "text": "E quanto mais tempo fica, menos paga:"
  },
  {
   "id": "L12",
   "file": "longstay/narration/L12.wav",
   "start": 36.05,
   "dur": 3.87,
   "text": "em estadias com mais de 28 dias, tem 30% de desconto."
  },
  {
   "id": "L13",
   "file": "longstay/narration/L13.wav",
   "start": 40.4,
   "dur": 1.62,
   "text": "Reserve já a sua estadia."
  },
  {
   "id": "L14",
   "file": "longstay/narration/L14.wav",
   "start": 42.6,
   "dur": 3.21,
   "text": "HD Properties. Fique o tempo que quiser."
  }
 ],
