{
 "fps": 60,
 "duration": 56.4,
 "nohookStart": 3.84,
 "vo": [
  {
   "id": "H01",
   "file": "longstay/narration3/H01.wav",
   "start": 0.06,
   "dur": 2.483,
   "text": "Pare. Não reserve o Algarve à semana."
  },
  {
   "id": "L01",
   "file": "longstay/narration3/L01.wav",
   "start": 3.95,
   "dur": 2.188,
   "text": "Uma semana no Algarve passa a voar."
  },
  {
   "id": "L02",
   "file": "longstay/narration3/L02.wav",
   "start": 7.02,
   "dur": 2.938,
   "text": "E se ficasse um mês… e pagasse menos por noite?"
  },
  {
   "id": "L03",
   "file": "longstay/narration3/L03.wav",
   "start": 11.56,
   "dur": 2.263,
   "text": "Para quem quer fugir ao frio do inverno."
  },
  {
   "id": "L04",
   "file": "longstay/narration3/L04.wav",
   "start": 13.96,
   "dur": 1.956,
   "text": "Para quem joga golfe o ano inteiro."
  },
  {
   "id": "L05",
   "file": "longstay/narration3/L05.wav",
   "start": 16.36,
   "dur": 1.722,
   "text": "Para quem trabalha de qualquer lado."
  },
  {
   "id": "L06",
   "file": "longstay/narration3/L06.wav",
   "start": 18.28,
   "dur": 1.653,
   "text": "Para quem está entre casas."
  },
  {
   "id": "L07",
   "file": "longstay/narration3/L07.wav",
   "start": 20.2,
   "dur": 1.084,
   "text": "Para quem vem estudar."
  },
  {
   "id": "L08",
   "file": "longstay/narration3/L08.wav",
   "start": 21.64,
   "dur": 2.679,
   "text": "Ou para quem, simplesmente, quer ficar mais tempo."
  },
  {
   "id": "E01",
   "file": "longstay/narration3/E01.wav",
   "start": 25.06,
   "dur": 2.566,
   "text": "O Algarve sabe melhor… sem pressa."
  },
  {
   "id": "L09",
   "file": "longstay/narration3/L09.wav",
   "start": 29.22,
   "dur": 4.34,
   "text": "Na HD Properties, temos casas prontas a viver, de Vilamoura a Olhão."
  },
  {
   "id": "T01",
   "file": "longstay/narration3/T01.wav",
   "start": 34.08,
   "dur": 3.736,
   "text": "Do estúdio à moradia com piscina, há uma casa para cada orçamento."
  },
  {
   "id": "L10",
   "file": "longstay/narration3/L10.wav",
   "start": 38.46,
   "dur": 3.312,
   "text": "Totalmente equipadas, com apoio local 24 horas por dia."
  },
  {
   "id": "L11",
   "file": "longstay/narration3/L11.wav",
   "start": 43.24,
   "dur": 2.134,
   "text": "E quanto mais tempo fica, menos paga:"
  },
  {
   "id": "L12",
   "file": "longstay/narration3/L12.wav",
   "start": 45.824,
   "dur": 3.599,
   "text": "em estadias com mais de 28 dias, tem 30% de desconto."
  },
  {
   "id": "S01",
   "file": "longstay/narration3/S01.wav",
   "start": 49.98,
   "dur": 1.176,
   "text": "HD Properties."
  },
  {
   "id": "C01",
   "file": "longstay/narration3/C01.wav",
   "start": 51.115,
   "dur": 2.871,
   "text": "Reserve já a sua estadia, ou fale connosco."
  }
